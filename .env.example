# Firebase Web App Configuration
# Get these credentials from Firebase Console:
# 1. Visit https://console.firebase.google.com/
# 2. Create or select a project
# 3. Add a Web App (</> icon) and copy the firebaseConfig object values here
# 4. Under 'Authentication' -> 'Sign-in method', enable 'Google'
# 5. Under 'Firestore Database', click 'Create database' (start in production or test mode)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
